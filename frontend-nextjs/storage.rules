rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ========================================
    // Salon images
    // ========================================
    match /salons/{salonId}/images/{fileName} {
      // Public read for salon images
      allow read: if true;
      // Authenticated users can upload (salon owners manage via Firestore rules)
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024  // Max 10MB
        && request.resource.contentType.matches('image/.*');
    }

    // ========================================
    // User avatars
    // ========================================
    match /users/{userId}/avatar/{fileName} {
      // Public read for avatars
      allow read: if true;
      // Users can upload their own avatar
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024  // Max 5MB
        && request.resource.contentType.matches('image/.*');
    }

    // ========================================
    // Service images
    // ========================================
    match /salons/{salonId}/services/{serviceId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ========================================
    // Review images
    // ========================================
    match /reviews/{reviewId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ========================================
    // Offer images
    // ========================================
    match /offers/{offerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
