# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
# Set USE_REMOTE_DB=true to use remote database, false for local
USE_REMOTE_DB=false

# Local Database Configuration
LOCAL_DATABASE_URL="postgresql://username:password@localhost:5432/cutq_db?schema=public"

# Remote Database Configuration (Optional - only needed if USE_REMOTE_DB=true)
REMOTE_DATABASE_URL="postgresql://remote_user:remote_password@remote_host:5432/cutq_db?schema=public"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
# Multiple origins can be specified as comma-separated values
# Example: CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

# Admin Setup Configuration
ADMIN_SETUP_PASSWORD=admin-setup-2024

# Redis Configuration for Queue System
# Set USE_REMOTE_REDIS=true to use remote Redis, false for local
USE_REMOTE_REDIS=false

# Local Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Remote Redis Configuration (Optional - only needed if USE_REMOTE_REDIS=true)
REMOTE_REDIS_HOST=your-remote-redis-host
REMOTE_REDIS_PORT=6379
REMOTE_REDIS_PASSWORD=your-remote-redis-password
REMOTE_REDIS_DB=0

# Brand Configuration
BRAND_NAME=CutQ
BRAND_PHONE=+91 8197970532
BRAND_ADDRESS=New Delhi, IN 110001
BRAND_EMAIL=connect@cutq.store

FAST2SMS_API_KEY=your_actual_fast2sms_api_key_here

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_RTM0m3NrKIg8Dt
RAZORPAY_KEY_SECRET=rzp_test_RTM0m3NrKIg8Dt
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Payment Configuration
PAYMENT_REQUIRED_FOR_BOOKING=true
PAYMENT_TIMEOUT_MINUTES=15
