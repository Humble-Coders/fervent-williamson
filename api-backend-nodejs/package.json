{
  "name": "cutq-backend",
  "version": "1.0.0",
  "description": "CutQ management system backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "cross-env CUTQ_ENV=prod node scripts/environment/start-with-env.js node dist/index.js",
    "start:dev": "cross-env CUTQ_ENV=dev node scripts/environment/start-with-env.js node dist/index.js",
    "start:uat": "cross-env CUTQ_ENV=uat node scripts/environment/start-with-env.js node dist/index.js",
    "start:prod": "cross-env CUTQ_ENV=prod node scripts/environment/start-with-env.js node dist/index.js",
    "dev": "cross-env CUTQ_ENV=dev node scripts/environment/start-with-env.js nodemon --exec ts-node -r tsconfig-paths/register src/index.ts",
    "dev:uat": "cross-env CUTQ_ENV=uat node scripts/environment/start-with-env.js nodemon --exec ts-node -r tsconfig-paths/register src/index.ts",
    "dev:prod": "cross-env CUTQ_ENV=prod node scripts/environment/start-with-env.js nodemon --exec ts-node -r tsconfig-paths/register src/index.ts",
    "test": "cross-env CUTQ_ENV=dev jest",
    "test:watch": "cross-env CUTQ_ENV=dev jest --watch",
    "test:coverage": "cross-env CUTQ_ENV=dev jest --coverage",
    "test:unit": "cross-env CUTQ_ENV=dev jest --testPathPattern=tests/.*\\.test\\.ts$",
    "test:integration": "cross-env CUTQ_ENV=dev jest --testPathPattern=tests/integration/.*\\.test\\.ts$",
    "test:e2e": "cross-env CUTQ_ENV=dev jest --testPathPattern=tests/e2e/.*\\.test\\.ts$",
    "test:auth": "cross-env CUTQ_ENV=dev jest tests/auth.test.ts",
    "test:business": "cross-env CUTQ_ENV=dev jest tests/salon.test.ts",
    "test:booking": "cross-env CUTQ_ENV=dev jest tests/booking.test.ts",
    "test:user": "cross-env CUTQ_ENV=dev jest tests/user.test.ts",
    "test:otp": "cross-env CUTQ_ENV=dev jest tests/otp.test.ts",
    "test:config": "cross-env CUTQ_ENV=dev jest tests/systemConfig.test.ts",
    "test:ci": "cross-env CUTQ_ENV=dev jest --coverage --watchAll=false --passWithNoTests",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "type-check": "tsc --noEmit",
    "quality": "npm run lint && npm run format:check && npm run type-check",
    "quality:fix": "npm run lint:fix && npm run format",
    "pre-commit": "npm run quality && npm run test",
    "db:generate": "prisma generate",
    "db:status": "cross-env CUTQ_ENV=dev node scripts/environment/prisma-with-env.js migrate status",
    "db:status:uat": "cross-env CUTQ_ENV=uat node scripts/environment/prisma-with-env.js migrate status",
    "db:status:prod": "cross-env CUTQ_ENV=prod node scripts/environment/prisma-with-env.js migrate status",
    "db:deploy:prod": "cross-env CUTQ_ENV=prod node scripts/environment/prisma-with-env.js migrate deploy",
    "db:migrate:dev": "cross-env CUTQ_ENV=dev node scripts/environment/prisma-with-env.js migrate dev",
    "db:migrate:uat": "cross-env CUTQ_ENV=uat node scripts/environment/prisma-with-env.js migrate dev",
    "migrate:create": "cross-env CUTQ_ENV=dev node scripts/environment/prisma-with-env.js migrate dev --create-only",
    "db:studio": "cross-env CUTQ_ENV=dev node scripts/environment/prisma-with-env.js studio",
    "db:studio:uat": "cross-env CUTQ_ENV=uat node scripts/environment/prisma-with-env.js studio",
    "db:studio:prod": "cross-env CUTQ_ENV=prod node scripts/environment/prisma-with-env.js studio",
    "db:seed": "cross-env CUTQ_ENV=dev ts-node -r tsconfig-paths/register prisma/seed.ts",
    "db:seed:uat": "cross-env CUTQ_ENV=uat ts-node -r tsconfig-paths/register prisma/seed.ts",
    "db:seed:prod": "cross-env CUTQ_ENV=prod ts-node -r tsconfig-paths/register prisma/seed.ts",
    "db:reset": "cross-env CUTQ_ENV=dev ts-node -r tsconfig-paths/register src/scripts/resetDatabase.ts",
    "db:reset:uat": "cross-env CUTQ_ENV=uat ts-node -r tsconfig-paths/register src/scripts/resetDatabase.ts",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "postinstall": "prisma generate",
    "pm2:start": "pm2 start ecosystem.config.js --env prod",
    "pm2:start:uat": "pm2 start ecosystem.config.js --env uat",
    "pm2:start:dev": "pm2 start ecosystem.config.js --env dev",
    "pm2:stop": "pm2 stop cutq-backend-prod",
    "pm2:stop:uat": "pm2 stop cutq-backend-uat",
    "pm2:stop:dev": "pm2 stop cutq-backend-dev",
    "pm2:restart": "pm2 restart cutq-backend-prod",
    "pm2:restart:uat": "pm2 restart cutq-backend-uat",
    "pm2:restart:dev": "pm2 restart cutq-backend-dev",
    "pm2:reload": "pm2 reload cutq-backend-prod",
    "pm2:reload:uat": "pm2 reload cutq-backend-uat",
    "pm2:logs": "pm2 logs cutq-backend-prod",
    "pm2:logs:uat": "pm2 logs cutq-backend-uat",
    "pm2:logs:dev": "pm2 logs cutq-backend-dev",
    "pm2:status": "pm2 status",
    "pm2:monit": "pm2 monit",
    "pm2:delete": "pm2 delete cutq-backend-prod",
    "pm2:delete:uat": "pm2 delete cutq-backend-uat",
    "pm2:delete:dev": "pm2 delete cutq-backend-dev",
    "pm2:delete:all": "pm2 delete all",
    "env:test": "cross-env CUTQ_ENV=dev node scripts/utilities/test-env.js",
    "env:test:uat": "cross-env CUTQ_ENV=uat node scripts/utilities/test-env.js",
    "env:test:prod": "cross-env CUTQ_ENV=prod node scripts/utilities/test-env.js",
    "env:test:all": "npm run env:test && npm run env:test:uat && npm run env:test:prod"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "cutq",
    "beauty",
    "booking",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "type": "commonjs",
  "_moduleAliases": {
    "@": "src"
  },
  "dependencies": {
    "@types/bull": "^3.15.9",
    "@types/multer": "^2.0.0",
    "@types/node-fetch": "^2.6.13",
    "@types/redis": "^4.0.10",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.0",
    "express-validator": "^7.2.1",
    "fast-csv": "^4.3.6",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-facebook": "^3.0.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-twitter": "^1.0.4",
    "pg": "^8.16.3",
    "razorpay": "^2.9.6",
    "redis": "^5.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@prisma/client": "^6.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.1.0",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.16",
    "@types/passport-facebook": "^3.0.3",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-twitter": "^1.0.39",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-security": "^1.7.1",
    "jest": "^30.0.5",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.12.0",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
